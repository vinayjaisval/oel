<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
Options -MultiViews -Indexes
    </IfModule>
Header add Content-Security-Policy "upgrade-insecure-requests"
    RewriteEngine On

    # --- perf-hardening: block direct access to sensitive files ---
    # (defense in depth while the live docroot is still the project root, not public/)
    <FilesMatch "(^\.env.*|^\.git.*|^composer\.(json|lock)$|^package(-lock)?\.json$|^artisan$|^phpunit\.xml$|\.(log|sql)$)">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # The .git directory tree (FilesMatch above only matches filenames, not its contents)
    RewriteRule ^\.git(/.*)?$ - [F,L]

    # --- Serve files from public/ when they're not present at the project root ---
    # Lets asset()/url() calls stay docroot-agnostic (e.g. asset('imagesapi/x.jpg') instead of
    # asset('public/imagesapi/x.jpg')). public/$1 is a relative path, so mod_rewrite resolves it
    # against the directory containing this .htaccess (the project root) rather than
    # %{DOCUMENT_ROOT} - works whether that directory IS the vhost docroot (production) or a
    # subfolder of a shared docroot (e.g. local WAMP's http://localhost/overseas/). Becomes a
    # no-op once the docroot is ever switched to public/ directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Block direct access to internal/dependency directories (after the public/ fallback above
    # has had a chance to serve anything legitimately published under public/).
    RewriteRule ^(storage|vendor|bootstrap/cache|node_modules)(/|$) - [F,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Handle Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
